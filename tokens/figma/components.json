[
 {
  "id": "23:19",
  "name": "Badge",
  "type": "COMPONENT_SET",
  "description": "Status pill. Fill + text, no border. The 500 mid-tone paints both label and dot, so the pill reads as one hue. Dot=false makes it a plain label pill for non-status metadata such as counts or tags. For bare numbers use Count instead.",
  "properties": {
   "Label": {
    "type": "TEXT",
    "default": "Estado",
    "options": null
   },
   "Dot": {
    "type": "BOOLEAN",
    "default": true,
    "options": null
   },
   "Tone": {
    "type": "VARIANT",
    "default": "success",
    "options": [
     "success",
     "warning",
     "danger",
     "idle"
    ]
   }
  },
  "variants": [
   "Tone=success",
   "Tone=warning",
   "Tone=danger",
   "Tone=idle"
  ]
 },
 {
